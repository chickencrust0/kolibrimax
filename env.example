# ==================== MAX ====================

MAX_BOT_TOKEN=f9LHodD0cOKZOpBXr1WaV-D-nIDuYL89D7kVf63utSH7zDnfyD1FdpktMAdkLdUfcf-NkUMiqXDhI1X2Nx4o

MAX_API_URL=https://platform-api2.max.ru

# polling — long polling, ничего дополнительно настраивать не нужно
#           (годится для разработки/теста, НЕ для продакшена).
# webhook — нужен публичный HTTPS с доверенным сертификатом
#           (в т.ч. Минцифры) и заполненные MAX_WEBHOOK_* ниже.
MAX_MODE=polling

MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8080
MAX_WEBHOOK_PATH=/webhook

# Бот уже доверяет сертификату Минцифры (см. certs/, ssl_utils.py) —
# трогать не нужно, разве что антивирус подменяет TLS своим сертификатом.
MAX_SSL_VERIFY=true

# ЗАПОЛНИТЕ: ID пользователей MAX, которые входят как менеджеры (через
# запятую). Без этого сводки, заявки на перенос и уведомления о низком
# балансе отправлять некому. Узнать свой ID: напишите боту /start и
# посмотрите лог первого входа — там будет виден from_user.id.
# Пароль для входа менеджера командой /manager — так можно подключать
# новых сотрудников без правки этого файла и перезапуска бота.
# ОБЯЗАТЕЛЬНО смените: значение по умолчанию есть в исходниках.
MANAGER_PASSWORD=kolibri-manager

# Счётчик оставшихся беспричинных заморозок хранится в CRM в поле
# АДРЕСА ПРОЖИВАНИЯ клиента (отдельного поля под это нет). Пустое поле
# = 0 заморозок.
#
# Раньше здесь стоял email — поле оказалось занято настоящей почтой, и
# счётчик с ней конфликтовал.
#
# ВАЖНО: значением считается только строка ЦЕЛИКОМ из цифр. Выбирать
# цифры из строки нельзя: адрес обычно заполнен по-настоящему, и
# «ул. Ленина, д. 5» дало бы клиенту пять заморозок. Непустой
# нечисловой адрес = 0 заморозок и предупреждение в лог.
#
# Точное имя поля impulseCRM не публикует, поэтому переменная оставлена
# ПУСТОЙ: бот сам находит первое подходящее поле в карточке клиента и
# один раз пишет в лог, какое именно:
#
#     🏠 Счётчик беспричинных заморозок хранится в поле 'address' карточки клиента
#
# Проверьте эту строку при первом запуске. Если поле не то — впишите имя
# сюда, и поиск отключится.
IMPULSE_FIELD_CLIENT_FREEZES=

# Кандидаты для автоопределения, в порядке проверки. Менять обычно не нужно.
IMPULSE_FIELD_CLIENT_FREEZES_ALT=address,livingAddress,addressLiving,homeAddress,residenceAddress,actualAddress,addressFact,registrationAddress

ADMIN_MAX_IDS=

DB_PATH=bot.db

# ==================== impulseCRM ====================

IMPULSE_DOMAIN=https://akademiakolibriyandexru.impulsecrm.ru

IMPULSE_LOGIN=Директор
# Это значение подставляется в заголовок "Authorization: Basic <ключ>"
# КАК ЕСТЬ, без дополнительного base64(login:key) — подтверждено
# примером запроса из вашего личного кабинета. IMPULSE_LOGIN в
# авторизации не участвует.
IMPULSE_API_KEY=38ef7e4a41454dce33191dc7a238fd75

# Подтверждено примером запроса из вашего личного кабинета.
IMPULSE_API_PATH=/api/public/{entity}/{action}

# Не публикуется вендором — до уточнения держим консервативно.
IMPULSE_RPS=3.0

IMPULSE_SSL_VERIFY=true

BRANCH_ID=1

# ==================== Схема impulseCRM (снята вашим impulse_introspect.py) ====================
#
# ВАЖНО: schedule в вашем аккаунте — это строки ПОВТОРЯЮЩЕГОСЯ ПРАВИЛА
# (day/minutesBegin/minutesEnd/dateBegin/dateEnd: например, "по вторникам
# 16:00–17:00 с 25.08.2026 по 29.12.2026"), а не одна запись на одно
# фактическое занятие. Бот разворачивает такие правила в конкретные даты
# для показа расписания. НО: reservation, individual_single, group_single
# у вас пока пустые — поэтому непонятно, чем в impulseCRM фиксируется
# посещение/статус КОНКРЕТНОЙ даты группового занятия. Пока это не
# выяснено, кнопка "Прикрепить ДЗ" у преподавателя будет отвечать
# понятной ошибкой для таких занятий, вместо того чтобы испортить данные
# не в той записи. (Кнопки "Отметить как проведённый" больше нет —
# от преподавателя требуется только посещаемость.) Уточните у
# поддержки impulseCRM (@impulsCRM_manager в Telegram), как API
# фиксирует посещение конкретной даты группового занятия — после этого
# скажите мне, и я донастрою update_lesson().

IMPULSE_FIELD_SCHEDULE_DATE=date
IMPULSE_FIELD_SCHEDULE_TIME_FROM=timeFrom
IMPULSE_FIELD_SCHEDULE_TIME_TO=timeTo
IMPULSE_FIELD_SCHEDULE_DAY=day
IMPULSE_FIELD_SCHEDULE_MINUTES_BEGIN=minutesBegin
IMPULSE_FIELD_SCHEDULE_MINUTES_END=minutesEnd
IMPULSE_FIELD_SCHEDULE_DATE_BEGIN=dateBegin
IMPULSE_FIELD_SCHEDULE_DATE_END=dateEnd

IMPULSE_FIELD_SCHEDULE_TEACHER=teacher
IMPULSE_FIELD_SCHEDULE_GROUP=group
IMPULSE_FIELD_SCHEDULE_STATUS=status
IMPULSE_FIELD_SCHEDULE_TOPIC=topic
IMPULSE_FIELD_SCHEDULE_HOMEWORK=homework
IMPULSE_FIELD_SCHEDULE_NOTE=note

# reservation была пуста при снятии схемы — имена не подтверждены,
# доуточните после появления хотя бы одной записи.
IMPULSE_FIELD_RESERVATION_SCHEDULE=schedule
IMPULSE_FIELD_RESERVATION_CLIENT=client

# Подтверждено снятой схемой вашего аккаунта.
IMPULSE_FIELD_CLIENT_PHONE=phone
IMPULSE_FIELD_CLIENT_LAST_NAME=lastName
IMPULSE_FIELD_CLIENT_FIRST_NAME=name
IMPULSE_FIELD_CLIENT_MIDDLE_NAME=middleName
IMPULSE_FIELD_TEACHER_PHONE=phone
IMPULSE_FIELD_TEACHER_LAST_NAME=lastName
IMPULSE_FIELD_TEACHER_FIRST_NAME=name
IMPULSE_FIELD_TEACHER_MIDDLE_NAME=middleName

# У schedule в вашем аккаунте нет отдельного поля статуса в снятой схеме —
# всё показывается как "запланировано", пока не выяснится, как посещение
# фиксируется на самом деле (см. большой комментарий выше).
#
# STATUS_CONDUCTED преподавателем БОЛЬШЕ НЕ ВЫСТАВЛЯЕТСЯ: отметка
# «занятие проведено» убрана, от преподавателя требуется только
# посещаемость конкретных детей. Константа осталась, потому что её
# по-прежнему понимают старые записи в lesson_notes.
STATUS_PLANNED=1
STATUS_CANCELLED=2
STATUS_CONDUCTED=3

# Подтверждено: денежный баланс — поле client.deposit (у вас сейчас 0 —
# похоже, деньги в этой CRM считаются через абонементы/оплаты, а не
# через депозит).
IMPULSE_FIELD_CLIENT_BALANCE=deposit

# Подтверждено: у вас реальные данные лежат в group_account (групповые
# абонементы: trainingsTotal=8, trainingsUsed=2, trainingsLeft=6 в
# примере) — individual_account пуста.
IMPULSE_ACCOUNT_ENTITY=group_account
# Абонементы бывают четырёх типов. Смотрим во все перечисленные —
# отсутствующие/пустые пропускаются молча. Раньше читался только один,
# и у клиента с индивидуальным абонементом остаток был нулевым.
IMPULSE_ACCOUNT_ENTITIES=group_account,individual_account,self_account
IMPULSE_FIELD_ACCOUNT_CLIENT=client
IMPULSE_FIELD_ACCOUNT_PAID=trainingsTotal
IMPULSE_FIELD_ACCOUNT_USED=trainingsUsed

# ==================== Прочее ====================

TIMEZONE=Europe/Moscow

CACHE_DAYS_BACK=30
CACHE_DAYS_FORWARD=60
CACHE_REFRESH_MINUTES=5

MAX_LESSON_CARDS=20
LOW_BALANCE_THRESHOLD=2

# ==================== ОСТАТОК ЗАНЯТИЙ (БАЛАНС) ====================
#
# Баланс в боте = остаток занятий в абонементе, а не деньги.
# Берём trainingsLeft, который CRM считает сама: при заморозке,
# продлении и подарочных занятиях арифметика total-used врёт.
IMPULSE_FIELD_ACCOUNT_LEFT=trainingsLeft
IMPULSE_FIELD_ACCOUNT_ACTIVE=active
IMPULSE_FIELD_ACCOUNT_CLOSED=closed
IMPULSE_FIELD_ACCOUNT_FREEZE=freeze
IMPULSE_FIELD_ACCOUNT_TYPE_NAME=typeName
IMPULSE_FIELD_ACCOUNT_END_DATE=endDate
IMPULSE_FIELD_ACCOUNT_DAYS_LEFT=daysLeft

# ==================== СВЯЗЬ «УЧЕНИК → ЗАНЯТИЕ» ====================
#
# ВАЖНО. reservation в вашем аккаунте пуста, а это штатный способ
# связать клиента с занятием. Пока она пуста, бот определяет учеников
# группы по абонементам, привязанным к группам (поле groups у
# *_account). ЧТОБЫ РАСПИСАНИЕ И ДЗ У РОДИТЕЛЕЙ ЗАРАБОТАЛИ, в CRM у
# абонемента должна быть указана группа — либо должны появиться записи
# (reservation). Если ни того, ни другого нет, бот пишет об этом
# предупреждением в лог при каждом обновлении кеша.
IMPULSE_FIELD_ACCOUNT_GROUPS=groups

# Точная запись ученика на занятие важнее членства в группе.
# true  — если про ученика есть точные записи, показываем только их;
# false — складывать оба источника (тогда виден весь график группы).
STRICT_ENROLLMENT=true
IMPULSE_FIELD_SCHEDULE_CLIENT=client
IMPULSE_FIELD_SCHEDULE_TARGET=target
IMPULSE_FIELD_GROUP_STYLE=style

# Сколько секунд держать в памяти справочники (клиенты, педагоги,
# абонементы, карта групп).
IMPULSE_LOOKUP_TTL=120

# Тема, ДЗ и отметка «проведён» хранятся в БД бота: у сущности schedule
# в impulseCRM таких полей нет вовсе. Включайте запись в CRM только
# если вендор подтвердит, что поля появились.
IMPULSE_WRITE_BACK=false

# ==================== ВОРОНКА НОВЫХ КЛИЕНТОВ ====================

# Вести журнал активности в боте.
#
# Активность БОЛЬШЕ НЕ ПРИСЫЛАЕТСЯ менеджеру сообщениями: при десятке
# посетителей лента состояла почти целиком из неё, и в ней терялось
# главное — заявки, обращения и решения по неявкам. Теперь события
# копятся в БД и показываются только по кнопке «👀 Активность в боте»
# в меню менеджера.
#
# false — не вести журнал вовсе (кнопка будет отвечать «активности не было»).
MANAGER_NOTIFY_ACTIVITY=true

# MANAGER_NOTIFY_DELAY больше не используется — отправлять нечего.

# Сколько последних посетителей показывать по кнопке и сколько действий
# раскрывать по каждому.
ACTIVITY_USERS_LIMIT=15
ACTIVITY_EVENTS_PER_USER=12

# Сколько дней хранить журнал (чистится ночным заданием в 03:30).
ACTIVITY_KEEP_DAYS=14

SCHOOL_NAME=Детская академия развития «Колибри»
SCHOOL_SITE=https://kolibri-academy.ru/
MIN_AGE=3
MAX_AGE=16

# ==================== ЗАМОРОЗКИ И СГОРЕВШИЕ ЗАНЯТИЯ ====================

# За сколько часов до начала занятия родитель ещё может его заморозить —
# и по уважительной причине, и без причины. Позже кнопки заморозки в
# расписании не показываются, а нажатие старой кнопки из истории чата
# получает мягкий отказ со ссылкой на менеджера.
FREEZE_DEADLINE_HOURS=5

# Через сколько минут ПОСЛЕ начала занятия бот вправе считать его
# сгоревшим и уведомить родителя. Запас нужен, чтобы преподаватель успел
# проставить посещаемость: сразу после звонка отметок ещё нет.
BURN_NOTIFY_AFTER_MINUTES=90

# Как часто планировщик ищет сгоревшие занятия (минуты).
BURN_CHECK_INTERVAL_MINUTES=15

# На сколько дней вперёд родитель и преподаватель видят занятия
# в разделе «❄️ Заморозить занятие».
FREEZE_LOOKAHEAD_DAYS=14

# ==================== Отметка посещений (check_visits) ====================
# ПОДТВЕРЖДЕНО пробой: методы лежат под /api/public/, принимают только POST.
# check_visits/visits вернул реальные данные — механизм рабочий.
IMPULSE_CHECK_VISITS_ENABLED=true
IMPULSE_INTERNAL_PATH=/api/public/{path}
IMPULSE_PATH_CHECK=check_visits/check
IMPULSE_PATH_BURN=check_visits/burn_one
IMPULSE_PATH_VISITS=check_visits/visits
IMPULSE_PATH_LAST_ACCOUNTS=client/last_accounts
# Заполняйте ТОЛЬКО если impulse_probe.py скажет «cookie НУЖНА».
IMPULSE_SESSION_COOKIE=

# Вечерняя сводка менеджеру по неявкам (часовой пояс филиала).
ABSENCE_DIGEST_HOUR=21
ABSENCE_DIGEST_MINUTE=0
